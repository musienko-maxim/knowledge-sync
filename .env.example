# Configuration reference/template; the CLI does not automatically load .env.
# Set supported environment variables in your shell/process environment.

# Existing local vault; optional guard against placing the DB inside it. No vault output yet.
OBSIDIAN_VAULT_PATH=
# youtube sync: --db overrides this; this path is also the default when unset/empty.
# Relative to the working directory; must be outside the vault.
DATABASE_PATH=./data/knowledge-sync.sqlite
# Required by youtube sync --auth api-key (the default); not required for --auth oauth.
YOUTUBE_API_KEY=
# Desktop OAuth client JSON outside the repository. Export in your shell; .env is not loaded.
KNOWLEDGE_SYNC_GOOGLE_CREDENTIALS_FILE=
