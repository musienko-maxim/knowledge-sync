# Configuration reference/template; the CLI does not automatically load .env.
# Set supported environment variables in your shell/process environment.

# sync-obsidian: --vault overrides this; one nonblank value is required. No default or auto-creation.
# youtube sync also uses this as an optional guard against placing the DB inside the vault.
# sync-all uses the same guard without export; only explicit --vault enables its export.
OBSIDIAN_VAULT_PATH=
# All sync commands: --db overrides this; this path is also the default when unset/empty.
# Relative to the working directory; must be outside the vault.
DATABASE_PATH=./data/knowledge-sync.sqlite
# Single-playlist commands require this with --auth api-key; sync-all uses OAuth only.
YOUTUBE_API_KEY=
# Desktop OAuth client JSON outside the repository. Export in your shell; .env is not loaded.
KNOWLEDGE_SYNC_GOOGLE_CREDENTIALS_FILE=
